{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pop Up English Dictionary entry",
  "description": "One JSONL line in data/entries/. Documented contract; tools/dict_validate.py is the enforced implementation (stdlib-only, no jsonschema dependency).",
  "type": "object",
  "required": ["word", "senses", "editorial"],
  "additionalProperties": false,
  "properties": {
    "word": {
      "type": "string",
      "minLength": 1,
      "description": "Headword exactly as displayed and indexed. Letters, apostrophe, hyphen, space only."
    },
    "rank": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Frequency rank from data/worklist.tsv, when known."
    },
    "pronunciation": {
      "type": ["string", "null"],
      "description": "IPA, without enclosing slashes."
    },
    "senses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sense" }
    },
    "word_formation": {
      "$ref": "#/definitions/word_formation",
      "description": "Omit entirely when the word has not been analysed yet. analysable:false is an affirmative statement that no productive analysis exists."
    },
    "inflections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Inflected and variant written forms (fed to the StarDict .syn index so 'running' finds 'run')."
    },
    "editorial": { "$ref": "#/definitions/editorial" }
  },
  "definitions": {
    "sense": {
      "type": "object",
      "required": ["id", "definition", "part_of_speech", "connotation"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_'.-]*$",
          "description": "Stable, corpus-unique. Derived entries use <lemma-slug>.<synset-id>."
        },
        "definition": { "type": "string", "minLength": 1 },
        "learner": {
          "type": ["string", "null"],
          "description": "One plain sentence saying what the definition says, for a learner. The definition stays the OEWN gloss (tools/entry_validate.py holds it to the lexicon); this is the readable line beside it, never a replacement."
        },
        "part_of_speech": {
          "enum": ["noun", "verb", "adjective", "adverb", "pronoun", "determiner",
                   "preposition", "conjunction", "interjection", "numeral",
                   "particle", "abbreviation", "phrase"]
        },
        "connotation": {
          "type": "object",
          "required": ["label"],
          "additionalProperties": false,
          "properties": {
            "label": { "enum": ["positive", "negative", "neutral"] },
            "score": {
              "type": ["number", "null"],
              "minimum": -1,
              "maximum": 1,
              "description": "SentiWordNet PosScore - NegScore for this sense's synset. Absent when no source scored it."
            },
            "explanation": {
              "type": ["string", "null"],
              "description": "Why the sense carries this weight. MUST be absent/null when label is neutral (the fabrication rule, plan 5.4)."
            },
            "tone": {
              "type": ["string", "null"],
              "description": "Register/association description (e.g. 'Formal and academic; suggests reasoning before experience'). Allowed on any label - unlike explanation it makes no positive/negative claim."
            },
            "usage_labels": {
              "type": "array",
              "items": {
                "enum": ["informal", "formal", "slang", "vulgar", "derogatory",
                         "offensive", "humorous", "archaic", "dated", "literary",
                         "technical", "dialect", "euphemistic", "ironic"]
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Distinct. For reviewed/curated senses each example must contain the headword or an inflection."
        },
        "synonyms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "antonyms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "synset": { "type": "string", "description": "e.g. oewn-07697537-n" }
          }
        }
      }
    },
    "word_formation": {
      "type": "object",
      "required": ["analysable"],
      "additionalProperties": false,
      "properties": {
        "analysable": { "type": "boolean" },
        "prefixes": {
          "type": "array",
          "items": { "$ref": "#/definitions/prefix" },
          "description": "Only when analysable is true. Order: outermost first."
        },
        "root": {
          "type": ["object", "null"],
          "required": ["form"],
          "additionalProperties": false,
          "properties": { "form": { "type": "string", "minLength": 1 } }
        },
        "suffixes": {
          "type": "array",
          "items": { "$ref": "#/definitions/suffix" },
          "description": "Only when analysable is true. Order: innermost first."
        }
      }
    },
    "prefix": {
      "type": "object",
      "required": ["form", "meaning"],
      "additionalProperties": false,
      "properties": {
        "form": { "type": "string", "pattern": "^[a-z]+-$" },
        "meaning": { "type": "string", "minLength": 1 }
      }
    },
    "suffix": {
      "type": "object",
      "required": ["form", "meaning"],
      "additionalProperties": false,
      "properties": {
        "form": { "type": "string", "pattern": "^-[a-z]+$" },
        "meaning": { "type": "string", "minLength": 1 }
      }
    },
    "editorial": {
      "type": "object",
      "required": ["status", "revision", "sources"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["derived", "reviewed", "curated"],
          "description": "Quality tier, plan section 4. All tiers ship; the app labels them."
        },
        "revision": { "type": "integer", "minimum": 1 },
        "sources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Dataset identifiers, e.g. oewn-2024, sentiwordnet-3.0. Required non-empty for reviewed and curated."
        },
        "checks": {
          "type": "object",
          "description": "Review checklist flags recorded at review time (correctness, originality, bias, duplicates).",
          "additionalProperties": { "type": "boolean" }
        }
      }
    }
  }
}
